+static bool is_fuji(gphoto_driver *gphoto)
+{
+    return gphoto && gphoto->manufacturer && strcasestr(gphoto->manufacturer, "Fuji");
+}
+
+// Fuji: put the camera back to idle after an aborted capture sequence.
+// A failed shoot/bulb start (e.g. InitiateCapture -> 0x2002 with the dial on B, or bulb
+// start while the live-view open capture is still active) leaves the body mid-sequence and
+// every later op returns PTP Device Busy (0x2019) until a replug. USB port reset does NOT
+// clear it; this release does (tested X-T20 fw 2.11, 2026-11-24):
+//   d208 (Fuji capture control) = 0x0004 (release/cancel), then InitiateCapture (0x100e).
+// Both steps are best-effort; the InitiateCapture returns an error when the body was idle.
+static void fuji_release_capture(gphoto_driver *gphoto)
+{
+    CameraWidget *w = nullptr;
+    if (!gphoto || !gphoto->config)
+        return;
+    DEBUGDEVICE(device, INDI::Logger::DBG_WARNING, "Fuji: releasing aborted capture sequence (d208=0x0004 + InitiateCapture).");
+    CameraWidgetType wt;
+    if (gp_widget_get_child_by_name(gphoto->config, "d208", &w) == GP_OK && w &&
+            gp_widget_get_type(w, &wt) == GP_OK && (wt == GP_WIDGET_MENU || wt == GP_WIDGET_RADIO || wt == GP_WIDGET_TEXT))
+    {
+        gp_widget_set_value(w, "4");
+        int rc = gp_camera_set_single_config(gphoto->camera, "d208", w, gphoto->context);
+        DEBUGFDEVICE(device, INDI::Logger::DBG_DEBUG, "Fuji release: d208=4 -> %s", gp_result_as_string(rc));
+    }
+    w = nullptr;
+    if (gp_widget_get_child_by_name(gphoto->config, "opcode", &w) == GP_OK && w)
+    {
+        gp_widget_set_value(w, "0x100e,0x0,0x0");
+        int rc = gp_camera_set_single_config(gphoto->camera, "opcode", w, gphoto->context);
+        DEBUGFDEVICE(device, INDI::Logger::DBG_DEBUG, "Fuji release: InitiateCapture -> %s (error is normal if idle)",
+                     gp_result_as_string(rc));
+    }
+}
