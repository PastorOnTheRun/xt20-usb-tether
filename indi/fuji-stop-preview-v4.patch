+// Fuji bodies answer PTP 0x2019 Device Busy for a short while after live view stops.
+// Remember when the last preview stop happened so the next still exposure can settle
+// first. File-scope because the header is left untouched; one camera per driver process
+// is the normal case. Override the delay with INDI_GPHOTO_FUJI_SETTLE_MS (0 disables).
+namespace
+{
+std::chrono::steady_clock::time_point s_FujiPreviewStoppedAt {};
+bool s_FujiPreviewStopPending = false;
+
+int fujiSettleMs()
+{
+    const char *env = getenv("INDI_GPHOTO_FUJI_SETTLE_MS");
+    if (env && *env)
+    {
+        int v = atoi(env);
+        return v < 0 ? 0 : (v > 10000 ? 10000 : v);
+    }
+    return 750;
+}
+
+bool isFuji(gphoto_driver *drv)
+{
+    const char *m = drv ? gphoto_get_manufacturer(drv) : nullptr;
+    return m && strcasestr(m, "Fuji");
+}
